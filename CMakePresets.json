{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "core",
      "displayName": "core (no UI) - fast",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "Debug",
        "VORTCH_BUILD_UI": "OFF",
        "VORTCH_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "full",
      "inherits": "core",
      "displayName": "full (UI) - slow first build (wxWidgets)",
      "binaryDir": "${sourceDir}/build/full",
      "cacheVariables": {
        "VORTCH_BUILD_UI": "ON",
        "VCPKG_MANIFEST_FEATURES": "ui"
      }
    },
    {
      "name": "full-static",
      "inherits": "full",
      "displayName": "full static single-exe (x64-windows-static) - slow first build",
      "binaryDir": "${sourceDir}/build/full-static",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    }
  ],
  "buildPresets": [
    { "name": "core",        "configurePreset": "core" },
    { "name": "full",        "configurePreset": "full" },
    { "name": "full-static", "configurePreset": "full-static" }
  ]
}
